# Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json

# AWS credentials and private keys
.aws/
*.pem

# Kubernetes configuration
kubeconfig
.kube/

# Microsoft Word documents
*.docx

# OS files
.DS_Store
Thumbs.db

# VS Code local settings
.vscode/

# Temporary Helm files
.helm-temp/

# Temporary files
*.tmp